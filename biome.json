{
	"$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!wuwa_calc",
			"!data",
			"!public",
			"!dist",
			"!node_modules",
			"!src-tauri/target",
			"!src-tauri/crates/spectrum",
			"!src-tauri/protocol",
			"!docs/benchmarks/browser-results.json",
			"!**/*.generated.*",
			"!src/configs/{asset_aliases,character_*,echo_*,ghzs_thgl_mapping,inventory_*,map_icons,map_rules,preview_data,profile_portraits,progression,rotation_damage,spine_portraits,weapon_data}.json",
			"!samples"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
